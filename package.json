{
  "name": "@proj/workspace",
  "version": "0.3.1",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.20.0",
  "description": "TypeScript full-stack monorepo scaffold",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/dev.mjs api",
    "dev:web": "node scripts/dev.mjs web",
    "build": "node scripts/build.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test scripts/*.test.mjs && pnpm -r test",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "init": "node scripts/init.mjs",
    "doctor": "node scripts/doctor.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify": "pnpm version:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify:production && pnpm verify:repository",
    "verify:repository": "node scripts/verify-repository.mjs",
    "version:check": "node scripts/verify-version.mjs",
    "version:set": "node scripts/set-version.mjs",
    "app:start": "node scripts/app.mjs start",
    "app:run": "node scripts/run-app.mjs",
    "app:stop": "node scripts/app.mjs stop",
    "app:restart": "node scripts/app.mjs restart",
    "app:status": "node scripts/app.mjs status",
    "app:logs": "node scripts/app.mjs logs",
    "clean:build": "node scripts/clean.mjs build",
    "clean:deps": "node scripts/clean.mjs deps",
    "verify:generated": "node scripts/verify-generated.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "verify:push": "node scripts/verify-push.mjs",
    "logs:clean": "node scripts/app.mjs logs-clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "esbuild": "^0.28.0",
    "globals": "^17.12.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
